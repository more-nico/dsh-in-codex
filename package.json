{
  "name": "dsh-in-codex",
  "version": "0.1.0",
  "description": "Conversation-scoped DSH agents in the Codex desktop side panel",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/more-nico/dsh-in-codex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/more-nico/dsh-in-codex.git"
  },
  "bugs": {
    "url": "https://github.com/more-nico/dsh-in-codex/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "dsh-in-codex": "bin/dsh-in-codex.mjs"
  },
  "files": [
    "bin",
    "dist",
    "scripts/launch.sh",
    ".codex-plugin",
    ".mcp.json",
    "hooks",
    "skills",
    "assets",
    "docs/INTERFACE.md",
    "docs/SUBAGENT_PARITY.md",
    "docs/VALIDATION.md",
    "docs/plugin-intro.html",
    "docs/panel-preview.png",
    "package.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts/import-web-models.mjs",
    "scripts/profile.mjs",
    "AGENT_INSTALL.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import ./test/environment.mjs --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "dev:ui": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "pack:plugin": "node scripts/package.mjs",
    "prepack": "npm run build",
    "import:web-models": "node scripts/import-web-models.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "js-yaml": "^4.3.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
